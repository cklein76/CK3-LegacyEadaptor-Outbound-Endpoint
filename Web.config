<?xml version="1.0"?>
<configuration>
  
  <appSettings>
    <add key="StreamingBufferSize" value="65536"/>
    <!-- One entry per allowed login: key "PasswordHash:<user name>", value = SHA-512 of (user name + password)
         as dash-separated hex. Generate it with tools\New-PasswordHash.ps1. Logins without an entry are rejected. -->
    <add key="PasswordHash:BG1LAXTRN" value="REPLACE_WITH_HASH_FROM_New-PasswordHash.ps1"/>
  </appSettings>
  
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel" switchValue="Information, ActivityTracing" propagateActivity="true">
        <listeners>
          <add name="traceListener" type="System.Diagnostics.XmlWriterTraceListener" initializeData="C:\TEMP\WCFLogs\Server\Traces.svclog"/>
        </listeners>
      </source>
    </sources>
  </system.diagnostics>

  <system.web>
    <compilation debug="true" targetFramework="4.0"/>
    <authentication mode="Windows"/>
    <httpRuntime maxRequestLength="2097151" executionTimeout="300"/>
  </system.web>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="HttpStreamingService" receiveTimeout="04:00:00"
				 sendTimeout="04:00:00" maxBufferPoolSize="524288000" maxReceivedMessageSize="104857600"
				 transferMode="Streamed">
          <security mode="TransportWithMessageCredential">
            <transport>
              <extendedProtectionPolicy policyEnforcement="Never" />
            </transport>
            <message clientCredentialType="UserName" />
          </security>
        </binding>
      </basicHttpBinding>
      <mexHttpsBinding>
        <binding name="SecureMex" />
      </mexHttpsBinding>
    </bindings>
    
    <services>
      <service behaviorConfiguration="CargoWise.eAdapterOutboundWebService.eAdapterStreamedServiceBehavior" name="CargoWise.eAdapterOutboundWebService.eAdapterOutboundWebService">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="HttpStreamingService" contract="CargoWise.eHub.Common.IeAdapterStreamedService"/>
        <endpoint address="BG1LAXTRN" binding="basicHttpBinding" bindingConfiguration="HttpStreamingService" contract="CargoWise.eHub.Common.IeAdapterStreamedService"/>
        <endpoint address="mex" binding="mexHttpsBinding" contract="IMetadataExchange" />
      </service>
    </services>
    
    <behaviors>
      <serviceBehaviors>
        <behavior name="CargoWise.eAdapterOutboundWebService.eAdapterStreamedServiceBehavior">
          <serviceCredentials>
            <serviceCertificate findValue="syd-wbjg-1.corporate.cargowise.com" storeLocation="LocalMachine" storeName="My" x509FindType="FindBySubjectName"/>
            <userNameAuthentication userNamePasswordValidationMode="Custom" customUserNamePasswordValidatorType="CargoWise.eAdapterOutboundWebService.eHubUserNamePasswordValidator, CargoWise.eAdapterOutboundWebService, Version=1.0.0.0, Culture=neutral"/>
          </serviceCredentials>
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="false"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  
</configuration>
